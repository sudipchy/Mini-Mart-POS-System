  "QRPaymentSettings": {
    "eSewaEnabled": true,
    "KhaltiEnabled": true,
    "FonePayEnabled": true
  },
  "LoyaltySettings": {
    "PointsPerRupee": 1,
    "PointsForDiscount": 100,
    "DiscountPercentage": 5
  }
}
