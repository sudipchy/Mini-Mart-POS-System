@model MiniMartPOS.Models.ViewModels.StockTransactionViewModel
@{
    ViewData["Title"] = "Stock In";
}

<h2>Stock In</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="StockIn" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            
            <div class="form-floating mb-3">
                <select asp-for="ProductId" class="form-select" asp-items="@(new SelectList(ViewBag.Products, "Id", "ProductName"))">
                    <option value="">Select Product</option>
                </select>
                <label asp-for="ProductId">Product</label>
                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>
            
            <div class="form-floating mb-3">
                <input asp-for="Quantity" class="form-control" placeholder="Quantity" />
                <label asp-for="Quantity">Quantity</label>
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            
            <div class="form-floating mb-3">
                <textarea asp-for="Notes" class="form-control" placeholder="Notes" style="height: 100px;"></textarea>
                <label asp-for="Notes">Notes</label>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <button type="submit" class="btn btn-success"><i class="bi bi-arrow-down-circle"></i> Stock In</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
