@model MiniMartPOS.Models.ViewModels.POSViewModel
@{
    ViewData["Title"] = "POS Billing";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">POS Billing</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-8">
                        <div class="input-group">
                            <input type="text" id="barcodeInput" class="form-control" placeholder="Scan barcode or search product..." />
                            <button type="button" id="scanBtn" class="btn btn-primary"><i class="bi bi-upc-scan"></i> Scan</button>
                            <button type="button" id="searchBtn" class="btn btn-success"><i class="bi bi-search"></i> Search</button>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <select id="customerSelect" class="form-select">
                            <option value="">Walk-in Customer</option>
                        </select>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Qty</th>
                                <th>Discount</th>
                                <th>Total</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="cartItems">
                            <!-- Cart items will be added here dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Payment Summary</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span>Subtotal:</span>
                    <span id="subtotal">Rs. 0.00</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Discount:</span>
                    <input type="number" id="discount" class="form-control form-control-sm" style="width: 100px;" value="0" />
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Tax (13%):</span>
                    <span id="tax">Rs. 0.00</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between mb-3">
                    <strong>Grand Total:</strong>
                    <strong id="grandTotal">Rs. 0.00</strong>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Payment Method</label>
                    <select id="paymentMethod" class="form-select">
                        <option value="Cash">Cash</option>
                        <option value="Card">Card</option>
                        <option value="eSewa">eSewa</option>
                        <option value="Khalti">Khalti</option>
                        <option value="FonePay">FonePay</option>
                    </select>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Paid Amount</label>
                    <input type="number" id="paidAmount" class="form-control" value="0" />
                </div>
                
                <div class="d-flex justify-content-between mb-3">
                    <span>Change:</span>
                    <strong id="changeAmount">Rs. 0.00</strong>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Notes</label>
                    <textarea id="notes" class="form-control" rows="2"></textarea>
                </div>
                
                <button type="button" id="completeSaleBtn" class="btn btn-success w-100 btn-lg">
                    <i class="bi bi-check-circle"></i> Complete Sale
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let cart = [];
        
        $(document).ready(function() {
            // Barcode scanner
            $('#barcodeInput').keypress(function(e) {
                if(e.which == 13) {
                    e.preventDefault();
                    scanProduct();
                }
            });
            
            $('#scanBtn').click(scanProduct);
            $('#completeSaleBtn').click(completeSale);
            
            // Update totals when discount changes
            $('#discount').change(updateTotals);
            $('#paidAmount').change(updateTotals);
        });
        
        async function scanProduct() {
            const barcode = $('#barcodeInput').val();
            if(!barcode) return;
            
            try {
                const response = await fetch('/POS/ScanBarcode', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ barcode: barcode })
                });
                
                const result = await response.json();
                
                if(result.success) {
                    addToCart(result.product);
                    $('#barcodeInput').val('');
                } else {
                    alert(result.message);
                }
            } catch(error) {
                console.error('Error:', error);
            }
        }
        
        function addToCart(product) {
            const existingItem = cart.find(item => item.productId === product.id);
            
            if(existingItem) {
                existingItem.quantity++;
                existingItem.total = existingItem.quantity * existingItem.unitPrice;
            } else {
                cart.push({
                    productId: product.id,
                    productName: product.name,
                    quantity: 1,
                    unitPrice: product.price,
                    discount: 0,
                    total: product.price
                });
            }
            
            renderCart();
            updateTotals();
        }
        
        function renderCart() {
            const tbody = $('#cartItems');
            tbody.empty();
            
            cart.forEach((item, index) => {
                tbody.append(`
                    <tr>
                        <td>${item.productName}</td>
                        <td>Rs. ${item.unitPrice.toFixed(2)}</td>
                        <td>
                            <input type="number" class="form-control form-control-sm" 
                                   value="${item.quantity}" min="1" 
                                   onchange="updateQuantity(${index}, this.value)" />
                        </td>
                        <td>
                            <input type="number" class="form-control form-control-sm" 
                                   value="${item.discount}" min="0" 
                                   onchange="updateDiscount(${index}, this.value)" />
                        </td>
                        <td>Rs. ${item.total.toFixed(2)}</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-danger" onclick="removeFromCart(${index})">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                `);
            });
        }
        
        function updateQuantity(index, quantity) {
            cart[index].quantity = parseInt(quantity);
            cart[index].total = cart[index].quantity * cart[index].unitPrice - cart[index].discount;
            renderCart();
            updateTotals();
        }
        
        function updateDiscount(index, discount) {
            cart[index].discount = parseFloat(discount);
            cart[index].total = cart[index].quantity * cart[index].unitPrice - cart[index].discount;
            renderCart();
            updateTotals();
        }
        
        function removeFromCart(index) {
            cart.splice(index, 1);
            renderCart();
            updateTotals();
        }
        
        function updateTotals() {
            const subtotal = cart.reduce((sum, item) => sum + item.total, 0);
            const discount = parseFloat($('#discount').val()) || 0;
            const tax = (subtotal - discount) * 0.13;
            const grandTotal = subtotal - discount + tax;
            const paidAmount = parseFloat($('#paidAmount').val()) || 0;
            const changeAmount = paidAmount - grandTotal;
            
            $('#subtotal').text(`Rs. ${subtotal.toFixed(2)}`);
            $('#tax').text(`Rs. ${tax.toFixed(2)}`);
            $('#grandTotal').text(`Rs. ${grandTotal.toFixed(2)}`);
            $('#changeAmount').text(`Rs. ${changeAmount.toFixed(2)}`);
        }
        
        async function completeSale() {
            if(cart.length === 0) {
                alert('Cart is empty!');
                return;
            }
            
            const request = {
                cartItems: cart,
                subtotal: parseFloat($('#subtotal').text().replace('Rs. ', '')),
                discount: parseFloat($('#discount').val()) || 0,
                tax: parseFloat($('#tax').text().replace('Rs. ', '')),
                grandTotal: parseFloat($('#grandTotal').text().replace('Rs. ', '')),
                paidAmount: parseFloat($('#paidAmount').val()) || 0,
                paymentMethod: $('#paymentMethod').val(),
                customerId: $('#customerSelect').val() || null,
                notes: $('#notes').val()
            };
            
            try {
                const response = await fetch('/POS/CompleteSale', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(request)
                });
                
                const result = await response.json();
                
                if(result.success) {
                    alert(`Sale completed! Invoice: ${result.invoiceNumber}`);
                    cart = [];
                    renderCart();
                    updateTotals();
                    $('#discount').val(0);
                    $('#paidAmount').val(0);
                    $('#notes').val('');
                    
                    // Print receipt
                    window.open(`/POS/Receipt/${result.saleId}`, '_blank');
                } else {
                    alert(result.message);
                }
            } catch(error) {
                console.error('Error:', error);
            }
        }
    </script>
}
