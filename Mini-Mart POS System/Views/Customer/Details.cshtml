@model MiniMartPOS.Models.Customer
@{
    ViewData["Title"] = "Customer Details";
}

<h2>Customer Details</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Customer Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Customer Name:</dt>
                    <dd class="col-sm-8">@Model.CustomerName</dd>
                    
                    <dt class="col-sm-4">Phone:</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>
                    
                    <dt class="col-sm-4">Email:</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    
                    <dt class="col-sm-4">Address:</dt>
                    <dd class="col-sm-8">@Model.Address</dd>
                    
                    <dt class="col-sm-4">Loyalty Points:</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-info">@Model.LoyaltyPoints pts</span>
                    </dd>
                    
                    <dt class="col-sm-4">Outstanding Balance:</dt>
                    <dd class="col-sm-8">
                        @if (Model.OutstandingBalance > 0)
                        {
                            <span class="badge bg-warning">Rs. @Model.OutstandingBalance.ToString("N2")</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Rs. 0.00</span>
                        }
                    </dd>
                    
                    <dt class="col-sm-4">Created Date:</dt>
                    <dd class="col-sm-8">@Model.CreatedDate.ToString("yyyy-MM-dd")</dd>
                    
                    <dt class="col-sm-4">Status:</dt>
                    <dd class="col-sm-8">
                        @if (Model.Status)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </dd>
                </dl>
                
                <div class="mt-3">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Loyalty Points Management</h5>
            </div>
            <div class="card-body">
                <form asp-action="AddPoints" method="post">
                    <input type="hidden" name="customerId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Add Points</label>
                        <div class="input-group">
                            <input type="number" name="points" class="form-control" placeholder="Points" required />
                            <button type="submit" class="btn btn-success">Add</button>
                        </div>
                    </div>
                </form>
                
                <hr>
                
                <form asp-action="RedeemPoints" method="post">
                    <input type="hidden" name="customerId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Redeem Points</label>
                        <div class="input-group">
                            <input type="number" name="points" class="form-control" placeholder="Points" max="@Model.LoyaltyPoints" required />
                            <button type="submit" class="btn btn-warning">Redeem</button>
                        </div>
                        <small class="text-muted">Available: @Model.LoyaltyPoints points</small>
                    </div>
                </form>
                
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    <strong>Loyalty Program:</strong> 100 points = 5% discount on next purchase
                </div>
            </div>
        </div>
    </div>
</div>
